generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL_LOCAL")
}

model Filial {
  id                      Int     @id @default(autoincrement())
  companyId               Int
  filial                  String
  quantidadeColaboradores Int
  linkUnico               String  @unique
  users                   Users[]

  company Company @relation(fields: [companyId], references: [id])
}

model Company {
  id   Int    @id @default(autoincrement())
  name String @unique
  filiais Filial[]

  FormVisibility FormVisibility[]

  Users Users[]
}

model Admin {
  id    Int    @id @default(autoincrement())
  login String @unique
  senha String
  role  String
}

model FormVisibility {
  id        Int     @id @default(autoincrement())
  companyId Int
  field     String
  isVisible Boolean

  company Company @relation(fields: [companyId], references: [id])

  @@unique([companyId, field]) // Cada empresa pode definir a visibilidade de cada campo
}

model Users {
  id               Int       @id @default(autoincrement())
  nomeCompleto     String?
  dataNascimento   DateTime?
  email            String?   
  cpf              String?
  escolaridade     String?
  estadoCivil      String?
  filhos           Int?
  quantidadeLivros Int?
  hobbie           String?
  tempoCasaTrab    String?
  modeloTrabalho   String?
  partGrupos       String?
  tempoEmpresa     String?
  areaTrabalho     String?
  filialId         Int
  companyId        Int
  funcao           String?
  genero           String?
  cidade           String?
  estado           String?
  pais             String?
  educacaoMetanoia Boolean?  @default(false)
  respondeuForm    Boolean?  @default(false)
  respostas        UserResponse[]

  filial Filial @relation(fields: [filialId], references: [id])
  company Company? @relation(fields: [companyId], references: [id])
}


model UserResponse {
  id       Int      @id @default(autoincrement())
  userId   Int
  question Int
  score    Float
  user     Users    @relation(fields: [userId], references: [id])

  @@unique([userId, question])
}

model Question {
  id    Int    @id @default(autoincrement())
  text  String
}